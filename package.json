{
  "name": "tablio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "build": "pnpm --filter @tablio/web build",
    "dev": "pnpm --filter @tablio/web dev",
    "dev:e2e": "TABLIO_E2E=1 pnpm --filter @tablio/web exec next dev --port 3100",
    "e2e": "playwright test",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.{ts,tsx}\" package.json pnpm-workspace.yaml tsconfig.json vitest.config.ts playwright.config.ts eslint.config.mjs README.md \"docs/*.md\" \"docs/adr/*.md\" \"docs/sprints/*.md\"",
    "lint": "eslint .",
    "load:sprint10": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/load/sprint-10-load.ts",
    "perf:sprint10": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/performance/sprint-10-pwa.ts",
    "test": "vitest run",
    "test:chaos": "vitest run tests/chaos/sprint-10-chaos.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
